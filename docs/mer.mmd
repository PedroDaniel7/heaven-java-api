  USUARIO ||--o{ HISTORICO_REPUTACAO : "tem"
  VALIDACAO |o--o{ HISTORICO_REPUTACAO : "motiva"
  USUARIO ||--o{ USUARIO_CONQUISTA : "conquista"
  CONQUISTA ||--o{ USUARIO_CONQUISTA : "concedida em"

erDiagram
  NIVEL_CONFIANCA {
    NUMBER ID PK
    VARCHAR2_30 NOME UK
    NUMBER_5_2 REPUTACAO_MINIMA
    NUMBER_4_2 PESO_VOTO
    NUMBER_4 LIMITE_VALIDACOES_DIA
    NUMBER_4 LIMITE_ACOES_DIA
  }
  USUARIO {
    NUMBER ID PK
    VARCHAR2_120 NOME
    VARCHAR2_150 EMAIL UK
    VARCHAR2_256 SENHA_HASH
    DATE DATA_CADASTRO
    VARCHAR2_20 STATUS_CONTA
    NUMBER_10 PONTOS_ATUAIS
    NUMBER_5_2 REPUTACAO_ATUAL
    NUMBER ID_NIVEL_CONFIANCA FK
    NUMBER_6 STREAK_ATUAL
    NUMBER_6 MAIOR_STREAK
    DATE DATA_ULTIMA_ACAO "opcional"
  }
  TIPO_ACAO {
    NUMBER ID PK
    VARCHAR2_100 NOME UK
    VARCHAR2_500 DESCRICAO "opcional"
    VARCHAR2_30 CATEGORIA
    VARCHAR2_20 UNIDADE_MEDIDA
    NUMBER_10_2 IMPACTO_AMBIENTAL_ESTIMADO
    NUMBER_6 PONTOS_BASE
    VARCHAR2_15 DIFICULDADE
    CHAR_1 STATUS_ATIVO
  }
  ACAO_USUARIO {
    NUMBER ID PK
    NUMBER ID_USUARIO FK
    NUMBER ID_TIPO_ACAO FK
    TIMESTAMP DATA_HORA
    NUMBER_10_2 QUANTIDADE
    NUMBER_12_2 IMPACTO_AMBIENTAL_CALCULADO
    NUMBER_8 PONTOS_PREVISTOS
    VARCHAR2_15 STATUS
    VARCHAR2_500 DESCRICAO_EVIDENCIA "opcional"
    DATE DATA_CONCLUSAO "opcional"
  }
  VALIDACAO {
    NUMBER ID PK
    NUMBER ID_ACAO FK
    NUMBER ID_VALIDADOR FK
    VARCHAR2_10 VOTO
    NUMBER_4_2 PESO_VOTO
    NUMBER_5_2 REPUTACAO_VALIDADOR_MOMENTO
    TIMESTAMP DATA_HORA
    VARCHAR2_500 JUSTIFICATIVA "opcional"
  }
  HISTORICO_PONTOS {
    NUMBER ID PK
    NUMBER ID_USUARIO FK
    NUMBER_10 QUANTIDADE
    VARCHAR2_25 TIPO_MOVIMENTACAO
    VARCHAR2_300 DESCRICAO "opcional"
    NUMBER ID_ACAO FK "opcional"
    TIMESTAMP DATA_HORA
  }
  HISTORICO_REPUTACAO {
    NUMBER ID PK
    NUMBER ID_USUARIO FK
    NUMBER_5_2 REPUTACAO_ANTERIOR
    NUMBER_5_2 REPUTACAO_NOVA
    VARCHAR2_200 MOTIVO
    NUMBER ID_VALIDACAO FK "opcional"
    TIMESTAMP DATA_HORA
  }
  CONQUISTA {
    NUMBER ID PK
    VARCHAR2_100 NOME UK
    VARCHAR2_300 DESCRICAO "opcional"
    VARCHAR2_300 REQUISITO
    NUMBER_8 PONTOS_BONUS
  }
  USUARIO_CONQUISTA {
    NUMBER ID_USUARIO PK, FK
    NUMBER ID_CONQUISTA PK, FK
    DATE DATA_CONQUISTA
  }
  INCIDENTE_FRAUDE {
    NUMBER ID PK
    NUMBER ID_USUARIO FK
    VARCHAR2_40 TIPO_INCIDENTE
    VARCHAR2_500 DESCRICAO "opcional"
    VARCHAR2_10 NIVEL_SEVERIDADE
    TIMESTAMP DATA_HORA
    VARCHAR2_20 STATUS
  }
  PENALIZACAO {
    NUMBER ID PK
    NUMBER ID_USUARIO FK
    NUMBER ID_INCIDENTE FK "opcional"
    VARCHAR2_30 TIPO_PENALIZACAO
    VARCHAR2_300 DESCRICAO "opcional"
    NUMBER_8 PONTOS_PERDIDOS
    NUMBER_5_2 REPUTACAO_REDUZIDA
    DATE DATA_INICIO
    DATE DATA_FIM "opcional"
    VARCHAR2_15 STATUS
  }
  PARAMETRO_SISTEMA {
    NUMBER ID PK
    VARCHAR2_50 NOME_PARAMETRO UK
    NUMBER_10_2 VALOR
    VARCHAR2_300 DESCRICAO "opcional"
  }

  NIVEL_CONFIANCA ||--o{ USUARIO : "classifica"
